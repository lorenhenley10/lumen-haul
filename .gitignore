# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# ALL media is out of git.
#
#   public/media/<Project>/   ~27GB of 4K camera masters, archived locally by
#                             hand. Never committed, never deployed.
#   public/media/derived/     ~425MB of web-ready loops, films, posters and
#                             stills. These now live in Cloudflare R2 and are
#                             served from https://media.lumenhaul.com — see
#                             docs/MEDIA-HOSTING.md.
#
# Only the tiny SVG placeholders stay in the repo, so a checkout with no R2
# access still renders something rather than broken frames.
#
# Regenerate derivatives:  ./scripts/encode-media.sh && ./scripts/encode-stills.sh
# Publish them:            ./scripts/sync-r2.sh
/public/media/*
!/public/media/placeholder/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Filled-in client estimates. Each one carries a client's name, their contact
# details and negotiated pricing, so they stay out of the repo. The master
# they are cut from — documents/lumen-haul-estimate-template.html — IS tracked,
# because that is the thing worth versioning.
#
# The PDFs are build output: regenerate with Chrome's print-to-pdf from the
# HTML beside them.
documents/estimates/
